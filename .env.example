DB_URL=jdbc:postgresql://localhost:5432/finance_tracker
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
JWT_ISSUER=finance-tracker
JWT_EXPIRATION=PT8H

# Docker Compose development database. Use a unique value outside local development.
POSTGRES_PASSWORD=finance_dev
POSTGRES_PORT=5432
